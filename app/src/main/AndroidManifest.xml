<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for monitoring streams, remote config, API calls, and downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for ConnectivityManager network checks and network callback listener. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Requested by your requirements. ACCESS_NETWORK_STATE is the key permission for detecting drops. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Keep CPU awake while monitoring/recording in foreground service. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service support. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14+ specific permission for data sync foreground services. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ notification runtime permission. Must also be requested in code. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Allows restoring monitoring after device reboot if user enabled saved monitoring. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets app open battery optimization exemption screen. Ask user only when needed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Live Monitor"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- Main home screen:
             - URL input + Add Channel button
             - Monitoring tab
             - Downloads tab
             - 3-dot menu -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings screen:
             - Poll interval
             - Download quality
             - Save location
             - Scheduled monitoring
             - Remote config URL
             - Battery optimization helper -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Visible user-approved YouTube session / PO-token setup WebView for yt-dlp. -->
        <activity
            android:name=".YouTubeSignInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Global log screen. -->
        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Log category toggles. -->
        <activity
            android:name=".LogSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Per-channel log screen. -->
        <activity
            android:name=".ChannelLogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Downloaded recordings screen. -->
        <activity
            android:name=".DownloadedFilesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Foreground monitoring service:
             - Multi-channel monitoring
             - Per-channel notifications
             - Wake lock handling
             - Network callback handling
             - Auto retry/restart recording -->
        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Boot receiver:
             - Restores persisted monitoring after phone reboot
             - Restores after app package update
             - Only starts service if user enabled restoreMonitoringOnBoot -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider:
             Required so DownloadedFilesActivity can open completed MP4/TS files
             with external video players without exposing raw file:// paths. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
