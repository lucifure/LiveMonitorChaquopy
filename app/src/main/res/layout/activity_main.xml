<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/lm_screen_background">

    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/titleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="92dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Monitor"
                    android:textColor="@color/text"
                    android:textSize="34sp"
                    android:fontFamily="serif"
                    android:textStyle="normal"
                    android:letterSpacing="-0.02"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remote config ready"
                    android:textColor="#9ADAA0"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:padding="9dp"
                android:src="@drawable/ic_settings"
                android:tint="#AEB7C2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/addChannelRow"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/lm_search_container_background"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Paste YouTube channel URL..."
                android:textColor="@color/text"
                android:textColorHint="#91A0AA"
                android:textSize="18sp"
                android:background="@android:color/transparent"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:inputType="textUri"
                android:singleLine="true"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnAddChannel"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:text="＋  ADD"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:background="@drawable/lm_blue_add_pill_background"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/monitoringPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/monitoringHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTIVE RECORDINGS  ─────────────────"
                android:textColor="#B9C2CA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/storageHealthCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/lm_glass_card_background"
                android:elevation="10dp"
                android:padding="22dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Storage health"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:gravity="center" />

                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <com.livemonitor.app.StorageGaugeView
                        android:id="@+id/storageGaugeView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/storageFreeValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking"
                            android:textColor="@color/text"
                            android:textSize="42sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/storageFreeLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Free space"
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:layout_marginTop="-40dp"
                    android:layout_marginBottom="22dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0%"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="▱  Default App Storage"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:background="#55616B78" />

                    <TextView
                        android:id="@+id/storageHealthText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Status: checking"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/emptyMonitoringText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No channels added yet."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="20dp" />

            <ListView
                android:id="@+id/channelListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="12dp"
                android:background="@android:color/transparent"
                android:cacheColorHint="@color/background" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloadsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/downloadsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Downloads"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/downloadSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/lm_glass_card_background"
                android:elevation="10dp"
                android:padding="22dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/downloadSummaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 active downloads · 0 B/s · storage OK"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/emptyDownloadsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No active downloads. Go to Home to start monitoring a channel."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="20dp" />

            <ListView
                android:id="@+id/recordingListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="12dp"
                android:background="@android:color/transparent"
                android:cacheColorHint="@color/background" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/lm_bottom_nav_background"
        android:elevation="0dp"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:itemIconSize="28dp"
        app:itemActiveIndicatorColor="@color/accent_dim"
        app:itemActiveIndicatorWidth="84dp"
        app:itemActiveIndicatorHeight="46dp"
        app:itemTextAppearanceActive="@style/BottomNavTextActive"
        app:itemTextAppearanceInactive="@style/BottomNavTextInactive"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_bottom_nav" />
</LinearLayout>
