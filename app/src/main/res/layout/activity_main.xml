<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- Top header -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#00A884"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/titleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:contentDescription="Live Monitor icon" />

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live Monitor"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingStart="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#E7FFFA"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="150dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:backgroundTint="#00A884"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:contentDescription="Menu" />

        </LinearLayout>

        <!-- Fixed URL input + Add Channel -->
        <LinearLayout
            android:id="@+id/addChannelRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Paste YouTube channel URL..."
                android:textColor="#111B21"
                android:textColorHint="#667781"
                android:textSize="14sp"
                android:background="@drawable/input_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnAddChannel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Add"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#075E54"
                android:layout_marginStart="8dp"
                android:minWidth="74dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Main content area -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Monitoring tab -->
        <LinearLayout
            android:id="@+id/monitoringPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/monitoringHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monitoring"
                android:textColor="#111B21"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/emptyMonitoringText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No channels added yet."
                android:textColor="#667781"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="20dp" />

            <ListView
                android:id="@+id/channelListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp"
                android:background="#FFFFFF" />

        </LinearLayout>

        <!-- Downloading tab -->
        <LinearLayout
            android:id="@+id/downloadsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/downloadsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Downloading"
                android:textColor="#111B21"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/emptyDownloadsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No active downloads. Completed files are available from the menu."
                android:textColor="#667781"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="20dp" />

            <ListView
                android:id="@+id/recordingListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp"
                android:background="#FFFFFF" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/navMonitoring"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:id="@+id/navMonitoringIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#00A884"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/navMonitoringText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitoring"
                android:textColor="#00A884"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDownloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:id="@+id/navDownloadsIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textColor="#667781"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/navDownloadsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Downloading"
                android:textColor="#667781"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
